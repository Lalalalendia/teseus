{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theseus.invalid/survivor-lab/survivor-analysis-request.v1.schema.json",
  "title": "Theseus SurvivorAnalysisRequest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "project_id", "revision", "mutant", "source", "selection", "executions", "related_tests", "related_dependencies", "environment", "requested_modes"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"$ref": "#/$defs/nonEmptyString"},
    "project_id": {"$ref": "#/$defs/nonEmptyString"},
    "revision": {"type": ["string", "null"], "maxLength": 16000},
    "mutant": {"$ref": "#/$defs/mutant"},
    "source": {"$ref": "#/$defs/source"},
    "selection": {"$ref": "#/$defs/selection"},
    "executions": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/execution"}},
    "related_tests": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/test"}},
    "related_dependencies": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/dependency"}},
    "environment": {"anyOf": [{"$ref": "#/$defs/environment"}, {"type": "null"}]},
    "requested_modes": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["classify", "context", "hypotheses", "propose", "validation_plan"]}}
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1, "maxLength": 16000},
    "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "textArray": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
    "mutant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutant_id", "operator", "operator_version", "source_path", "function_id", "class_name", "line_no", "column_no", "original", "replacement", "diff", "status"],
      "properties": {
        "mutant_id": {"$ref": "#/$defs/nonEmptyString"},
        "operator": {"$ref": "#/$defs/nonEmptyString"},
        "operator_version": {"$ref": "#/$defs/nonEmptyString"},
        "source_path": {"$ref": "#/$defs/nonEmptyString"},
        "function_id": {"type": ["string", "null"], "maxLength": 16000},
        "class_name": {"type": ["string", "null"], "maxLength": 16000},
        "line_no": {"type": "integer", "minimum": 1},
        "column_no": {"type": "integer", "minimum": 0},
        "original": {"$ref": "#/$defs/nonEmptyString"},
        "replacement": {"$ref": "#/$defs/nonEmptyString"},
        "diff": {"type": ["string", "null"], "maxLength": 262144},
        "status": {"enum": ["survived", "timeout", "error", "infrastructure_error"]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "source_sha256", "source_text", "function_source", "function_start_line", "function_end_line"],
      "properties": {
        "source_path": {"$ref": "#/$defs/nonEmptyString"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "source_text": {"type": "string", "minLength": 1, "maxLength": 2097152},
        "function_source": {"type": ["string", "null"], "maxLength": 262144},
        "function_start_line": {"type": ["integer", "null"], "minimum": 1},
        "function_end_line": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selected_tests": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "related_test_nodeids": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "similar_mutant_ids": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "runtime_location_reached": {"type": ["boolean", "null"]},
        "mutated_branch_reached": {"type": ["boolean", "null"]},
        "boundary_values_observed": {"type": ["boolean", "null"]},
        "truth_table_observed": {"type": ["boolean", "null"]},
        "oracle_observed": {"type": ["boolean", "null"]},
        "assertions_observed": {"type": ["boolean", "null"]},
        "equivalent_observation": {"type": ["boolean", "null"]},
        "reachable_paths_proven": {"type": "boolean"},
        "static_reachability": {"type": ["string", "null"], "maxLength": 16000},
        "observed_effects_changed": {"type": ["boolean", "null"]},
        "selection_reasons": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/nonEmptyString"}}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_id", "level", "status", "exit_code", "timed_out", "infrastructure_failure", "restore_verified", "selected_tests", "observed_tests", "output_excerpt"],
      "properties": {
        "execution_id": {"$ref": "#/$defs/nonEmptyString"},
        "level": {"$ref": "#/$defs/nonEmptyString"},
        "status": {"enum": ["survived", "killed", "timeout", "error", "infrastructure_error", "cancelled"]},
        "exit_code": {"type": ["integer", "null"]},
        "timed_out": {"type": "boolean"},
        "infrastructure_failure": {"type": "boolean"},
        "restore_verified": {"type": "boolean"},
        "selected_tests": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "observed_tests": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "output_excerpt": {"type": ["string", "null"], "maxLength": 65536}
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeid", "selection_reasons", "executions", "failures", "killed_related_mutants"],
      "properties": {
        "nodeid": {"type": "string", "minLength": 1, "maxLength": 1000},
        "source_path": {"type": ["string", "null"], "maxLength": 16000},
        "source_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"},
        "source_text": {"type": ["string", "null"], "maxLength": 524288},
        "selection_reasons": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "executions": {"type": "integer", "minimum": 0},
        "failures": {"type": "integer", "minimum": 0},
        "median_duration_ms": {"type": ["number", "null"], "minimum": 0},
        "killed_related_mutants": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/nonEmptyString"}}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "relationship"],
      "properties": {
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "kind": {"$ref": "#/$defs/nonEmptyString"},
        "source_path": {"type": ["string", "null"], "maxLength": 16000},
        "version": {"type": ["string", "null"], "maxLength": 16000},
        "relationship": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {"type": ["string", "null"], "maxLength": 16000},
        "python_version": {"type": ["string", "null"], "maxLength": 16000},
        "markers": {"type": "array", "maxItems": 200, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "differences": {"type": "array", "maxItems": 200, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "stable": {"type": ["boolean", "null"]}
      }
    }
  }
}
